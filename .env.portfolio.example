# Perfil público e somente leitura. Copie para .env apenas para testar localmente.
APP_ENV=production
SERVICE_ROLE=web
AUTH_MODE=local
PORTFOLIO_DEMO_ENABLED=true

# Gere valores próprios. Nunca faça commit do arquivo .env.
SECRET_KEY=replace-with-at-least-32-random-characters
DEMO_PORTFOLIO_PASSWORD=replace-with-9-plus-characters
PRIVACY_CONTACT_EMAIL=you@example.com

# Produção
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
PUBLIC_BASE_URL=https://your-service.example
COOKIE_SECURE=true
TRUSTED_PROXY_COUNT=1
JSON_LOGS=true
LOG_LEVEL=INFO

# A vitrine não processa dados nem chama provedores externos.
QUEUE_ENABLED=false
SECURITY_REDIS_ENABLED=false
RATELIMIT_STORAGE_URI=memory://
ANTIVIRUS_ENABLED=false
SUBMISSION_REQUIRE_ANTIVIRUS=false
SUBMISSION_STORAGE_BACKEND=filesystem
AI_PROVIDER=gemini_api
AUTOPSY_ASSISTANT_MODE=off
TEAMS_GRAPH_ENABLED=false
