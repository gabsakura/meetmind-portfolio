# Perfil público e somente leitura. Copie para .env apenas para testar localmente.
APP_ENV=production
SERVICE_ROLE=web
AUTH_MODE=local
PORTFOLIO_DEMO_ENABLED=true
PORTFOLIO_CHAT_ENABLED=true
PORTFOLIO_CALENDAR_OAUTH_ENABLED=false

# Gere valores próprios. Nunca faça commit do arquivo .env.
SECRET_KEY=replace-with-at-least-32-random-characters
DEMO_PORTFOLIO_PASSWORD=replace-with-9-plus-characters
PRIVACY_CONTACT_EMAIL=you@example.com

# Teste privado de OAuth. Não use nenhum dos e-mails públicos @meetmind.example.
PORTFOLIO_CALENDAR_TEST_EMAIL=calendar-owner@example.com
PORTFOLIO_CALENDAR_TEST_PASSWORD=replace-with-12-plus-private-characters
CALENDAR_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common

# Produção
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
PUBLIC_BASE_URL=https://your-service.example
COOKIE_SECURE=true
TRUSTED_PROXY_COUNT=1
JSON_LOGS=true
LOG_LEVEL=INFO

# O chatbot consulta somente o contexto autorizado do MeetMind. A chave fica no ambiente.
GEMINI_API_KEY=replace-with-your-gemini-key
QUEUE_ENABLED=false
SECURITY_REDIS_ENABLED=false
RATELIMIT_STORAGE_URI=memory://
ANTIVIRUS_ENABLED=false
SUBMISSION_REQUIRE_ANTIVIRUS=false
SUBMISSION_STORAGE_BACKEND=filesystem
AI_PROVIDER=gemini_api
AUTOPSY_ASSISTANT_MODE=off
TEAMS_GRAPH_ENABLED=false
