# Vitrine pública somente leitura com contas privadas para a operação completa.
APP_ENV=production
SERVICE_ROLE=web
AUTH_MODE=local
PORTFOLIO_DEMO_ENABLED=true
PORTFOLIO_CHAT_ENABLED=true
PORTFOLIO_CALENDAR_OAUTH_ENABLED=true

# Gere valores próprios. Nunca faça commit do arquivo .env.
SECRET_KEY=replace-with-at-least-32-random-characters
DEMO_PORTFOLIO_PASSWORD=replace-with-9-plus-characters
PRIVACY_CONTACT_EMAIL=you@example.com

# Login individual Google/Microsoft e armazenamento criptografado dos tokens.
CALENDAR_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common

# Opcional: notificações externas. Sem SMTP, os alertas continuam no painel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Produção
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
PUBLIC_BASE_URL=https://your-service.example
COOKIE_SECURE=true
TRUSTED_PROXY_COUNT=1
JSON_LOGS=true
LOG_LEVEL=INFO

# O chatbot consulta somente o contexto autorizado do MeetMind. A chave fica no ambiente.
GEMINI_API_KEY=replace-with-your-gemini-key
QUEUE_ENABLED=false
SECURITY_REDIS_ENABLED=false
RATELIMIT_STORAGE_URI=memory://
ANTIVIRUS_ENABLED=false
SUBMISSION_REQUIRE_ANTIVIRUS=false
SUBMISSION_STORAGE_BACKEND=filesystem
AI_PROVIDER=gemini_api
AUTOPSY_ASSISTANT_MODE=off
TEAMS_GRAPH_ENABLED=false
