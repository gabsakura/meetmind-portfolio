{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meetmind.local/schemas/sector-playbook-v1.json",
  "title": "MeetMind sector playbook",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "version", "reviewed_at", "aliases", "sources", "subsectors", "critical_processes", "technologies", "common_indicators", "possible_problems", "positive_signals", "attention_signals", "diagnostic_questions", "conditional_recommendations", "prohibited_inferences", "meeting_type_rules"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "label": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date"},
    "aliases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unit_aliases": {"type": "array", "items": {"type": "string"}},
    "cnae_prefixes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]+$"}},
    "detection_terms": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "minItems": 1},
    "subsectors": {"type": "array"},
    "critical_processes": {"type": "array", "minItems": 1},
    "technologies": {"type": "array", "minItems": 1},
    "common_indicators": {"type": "array", "minItems": 1},
    "possible_problems": {"type": "array", "minItems": 1},
    "positive_signals": {"type": "array", "minItems": 1},
    "attention_signals": {"type": "array", "minItems": 1},
    "diagnostic_questions": {"type": "array", "minItems": 1},
    "conditional_recommendations": {"type": "array", "minItems": 1},
    "prohibited_inferences": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "meeting_type_rules": {"type": "object"}
  }
}
